generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Testimonial {
  id        String   @id
  name      String
  email     String   @default("")
  rating    Int
  service   String
  location  String   @default("")
  text      String
  recommend Boolean  @default(true)
  createdAt DateTime @default(now())
}

model PortalClient {
  id              String               @id
  name            String
  email           String               @unique
  phone           String
  accountType     String
  clientSince     String
  passwordHash    String
  salt            String
  profileComplete Boolean              @default(false)
  profileData     String               @default("{}")
  createdAt       DateTime             @default(now())
  documents       PortalDocument[]
  messages        PortalMessage[]
  taxReturns      PortalTaxReturn[]
  appointments    PortalAppointment[]
  invoices        PortalInvoice[]
  irsNotices      PortalIrsNotice[]
  legalCases      PortalLegalCase[]
  checklist       PortalChecklistItem[]
}

model PortalDocument {
  id              String       @id
  clientId        String
  client          PortalClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name            String
  category        String
  size            Int
  taxYear         Int
  status          String
  checklistItemId String?
  mimeType        String       @default("application/octet-stream")
  fileData        String?
  uploadedAt      DateTime     @default(now())

  @@index([clientId])
}

model PortalMessage {
  id        String       @id
  clientId  String
  client    PortalClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  from      String
  subject   String
  body      String
  read      Boolean      @default(false)
  sentAt    DateTime     @default(now())

  @@index([clientId])
}

model PortalTaxReturn {
  id             String       @id
  clientId       String
  client         PortalClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  year           Int
  type           String
  status         String
  filedDate      String?
  refundEstimate String?
  preparer       String
  lastUpdated    DateTime     @default(now())

  @@unique([clientId, year])
  @@index([clientId])
}

model PortalAppointment {
  id       String       @id
  clientId String
  client   PortalClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title    String
  date     String
  time     String
  type     String
  status   String
  notes    String?

  @@index([clientId])
}

model PortalInvoice {
  id          String       @id
  clientId    String
  client      PortalClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  description String
  amount      Float
  dueDate     String
  status      String
  taxYear     Int?

  @@index([clientId])
}

model PortalIrsNotice {
  id           String       @id
  clientId     String
  client       PortalClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  noticeNumber String
  issueDate    String
  topic        String
  status       String
  responseDue  String?
  assignedTo   String

  @@index([clientId])
}

model PortalLegalCase {
  id         String       @id
  clientId   String
  client     PortalClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title      String
  category   String
  status     String
  openedDate String
  nextStep   String

  @@index([clientId])
}

model PortalChecklistItem {
  id       String       @id
  clientId String
  client   PortalClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  itemKey  String
  label    String
  category String
  done     Boolean      @default(false)

  @@unique([clientId, itemKey])
  @@index([clientId])
}
