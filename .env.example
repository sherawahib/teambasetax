# Neon PostgreSQL (required)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Optional admin API token for production
# ADMIN_API_TOKEN=your-secure-admin-token

# Gmail SMTP for contact / appointment / newsletter forms
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=your-gmail@gmail.com
SMTP_FROM_NAME=TeamBased Tax
MAIL_TO=michael.reis@teambasedtax.com
# (MAIL_TO is ignored for firm notifications — always michael.reis@teambasedtax.com)
